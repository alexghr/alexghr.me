---
import Newsletter from "./Newsletter.astro";
const today = new Date();
---

<footer>
  <Newsletter />
  <p>
    © Alex Gherghisan, {today.getFullYear()}
  </p>
</footer>

<style>
  footer {
    display: flex;
    flex-flow: column;
    align-items: center;
    margin: 2rem auto 0rem;
    width: 85%;
    border-top: 1px solid rgb(0 0 0 / 10%);
    padding: 1rem 0;
    font-size: 0.75rem;
  }

  p {
    margin-top: 1rem;
  }
</style>
